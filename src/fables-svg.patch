+/** Asset export for the R1 creation: the stage alone, no hero, caption or tag. */
+export function backdropSvg(backdropName: string, lookName: string, sw: number, scale: number): { svg: string; floor: number } {
+  const scene = parseScene({ backdrop: backdropName, hero: { action: 'idle', from: 0, to: 0 }, caption: 'x' })!
+  const look = lookFor(lookName)
+  const rich = true
+  const pixelArt = look.pixel === true
+  const art = look.art
+  const painter = art?.painter(sw)
+  const stage = richBackdrop(scene, rng(`${scene.backdrop}|${scene.caption}|stage`), sw, GROUND_Y, W, false, !pixelArt && !look.grade && !art, painter)
+  const sky = art?.sky ?? stage.sky
+  const ground = art?.ground ?? stage.ground
+  const gradeBody = look.grade?.(sw, H, pixelArt) ?? ''
+  const grade = gradeBody && !pixelArt ? `<defs>${gradeFilter('lk-grade', sw, H, gradeBody)}</defs>` : ''
+  const edge = look.edge ?? sky
+  const svg =
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${sw} ${H}" width="${sw * scale}" height="${H * scale}" shape-rendering="crispEdges" style="display:block;background:${look.grade ? edge : ground}">` +
+    grade +
+    `<rect x="${-sw * 4}" y="${-H * 4}" width="${sw * 9}" height="${H * 4 + GROUND_Y}" fill="${look.grade ? edge : sky}"/>` +
+    (art?.defs ? `<defs>${art.defs(sw, H)}</defs>` : '') +
+    (pixelArt ? `<defs>${PIXELIZE(sw, { x: -100, y: -100, w: 1, h: 1 }, gradeBody)}</defs><g filter="url(#sc-pixelize)">` : '') +
+    (grade ? `<g filter="url(#lk-grade)">` : '') +
+    (look.grade ? `<rect width="${sw}" height="${H}" fill="${sky}"/>` : '') +
+    (art?.under?.(sw, H) ?? '') +
+    stage.back +
+    `<rect x="${-sw * 4}" y="${stage.groundTop}" width="${sw * 9}" height="${H * 4}" fill="${ground}"/>` +
+    stage.near +
+    // no vignette and no frame: the picture is tiled (mirrored) into an endless world, so its edges must stay plain
+    stage.lens.replace(/<rect[^>]*sc-vignette[^>]*\/>/g, '') +
+    (grade ? '</g>' : '') +
+    (pixelArt ? '</g>' : '') +
+    (look.texture?.(sw, H, GROUND_Y, pixelArt) ?? '') +
+    `</svg>`
+  return { svg, floor: stage.floor }
+}
