 /** How long a drawn scene's bubble waits for Claude before it appears, in seconds (0 when it appears at once). */
 export const speaksAfter = (svg: string) => Number(/data-part="speech"[^>]*\sdata-speaks="([\d.]+)"/.exec(svg)?.[1] ?? 0)
